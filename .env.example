DEBUG=true
DATABASE_URL=postgresql+asyncpg://seravops:seravops@postgres:5432/seravops
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google OAuth 2.0 & Authentication
ENABLE_LOCAL_AUTH=false
INITIAL_ADMIN_EMAIL=your.admin.email@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:7372/login/google/callback
GOOGLE_ALLOWED_DOMAINS=gmail.com
# Set to false so only users invited/pre-registered by an Admin can log in:
GOOGLE_AUTO_PROVISION=false
GOOGLE_DEFAULT_ROLE=developer

# SMTP / Outbound Invitation Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Seravops <noreply@yourdomain.com>"
SMTP_USE_TLS=true
APP_URL=http://localhost:7372

# Use localhost for commands executed inside the app container. For a remote
# target, set its host, SSH user, port, and private key path mounted in the app.
SERVER_1_HOST=localhost
SERVER_1_USER=root
SERVER_1_PORT=22
SERVER_1_KEY_PATH=
SERVER_2_HOST=192.0.2.20
SERVER_2_USER=deploy
SERVER_2_PORT=22
SERVER_2_KEY_PATH=/run/secrets/server_2_key

